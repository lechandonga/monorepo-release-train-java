<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{36}] %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="com.github.lechandonga.monoreporeleasetrainjava" level="INFO"/>
    <logger name="com.github.lechandonga.monoreporeleasetrainjava.tests" level="INFO"/>
</configuration>
